{
  "name": "atlas",
  "private": true,
  "version": "1.1.0",
  "description": "Atlas: a mobile-first strength training PWA with an on-device coach.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173",
