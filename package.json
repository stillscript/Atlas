  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^24.19.2",
    "fake-indexeddb": "^6.2.5",
    "sharp": "^0.35.5",
    "typescript": "~5.9.3",
    "vite": "^8.3.4",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22"
